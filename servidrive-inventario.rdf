    xmlns:schema="https://schema.org/">
    <rdf:Description rdf:about="https://servidrive.example/vehiculo/A005">
        <rdf:type rdf:resource="https://schema.org/Vehicle" />
        <schema:identifier>A005</schema:identifier>
        <schema:brand>Volkswagen</schema:brand>
        <schema:model>POL</schema:model>
        <schema:vehicleModelDate>2025</schema:vehicleModelDate>
        <schema:bodyType>Sedan</schema:bodyType>
        <schema:vehicleTransmission>Manual</schema:vehicleTransmission>
        <schema:mileageFromOdometer>
            <rdf:Description>
                <schema:value>10000</schema:value>
                <schema:unitCode>KMT</schema:unitCode>
            </rdf:Description>
        </schema:mileageFromOdometer>
        <schema:offers>
            <rdf:Description>
                <rdf:type rdf:resource="https://schema.org/Offer" />
                <schema:price>560000</schema:price>
                <schema:priceCurrency>MXN</schema:priceCurrency>
                <schema:availability rdf:resource="https://schema.org/InStock" />
            </rdf:Description>
        </schema:offers>
        <schema:image rdf:resource="http://localhost:3000/uploads/A005.jpg" />
    </rdf:Description>
